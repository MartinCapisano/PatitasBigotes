VITE_API_BASE_URL=http://localhost:8000

# Muestra u oculta MercadoPago como metodo de pago en el checkout.
# Espeja el MERCADOPAGO_ENABLED del backend, que es el candado real:
# ocultar la opcion aca no impide nada por si solo.
VITE_MERCADOPAGO_ENABLED=false

# Numero de WhatsApp del local (solo digitos, con codigo de pais). Lo usa el
# boton "Comprobar disponibilidad" de los productos por cantidad para abrir el
# chat con el pedido pre-cargado. Espeja el WHATSAPP_NUMBER del backend.
VITE_WHATSAPP_NUMBER=5493511234567
